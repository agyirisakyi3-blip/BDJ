# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Email (Resend)
RESEND_API_KEY=re_your_key
EMAIL_FROM=Attendance <noreply@attendance.app>

# Multi-tenancy
# Default tenant code applied when the client does not send one (dev convenience).
DEFAULT_TENANT=
# Secret used by the POST /provision endpoint to create new organisations.
# Leave EMPTY to enable fully self-serve signup (recommended for scaling).
# When set, provisioning is rejected unless this key is supplied.
MASTER_PIN=
# Max organisations creatable per calendar day (anti-abuse for open signup).
PROVISION_DAILY_LIMIT=50

# Billing / Stripe (optional). Leave STRIPE_SECRET_KEY empty to use instant
# plan changes without payment (dev mode). When set, plan upgrades create a
# Stripe Checkout session and are confirmed by the webhook below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# One-time price IDs shown on the plan cards (required when STRIPE_SECRET_KEY is set).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Public URL of the web app, used as the post-payment redirect (default: http://localhost:5173)
FRONTEND_URL=

# Server
PORT=3000

# Optional: database connection used only by `npm run apply-schema` (DDL runner).
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Google Sheets migration (only used by `npm run migrate`)
# SPREADSHEET_ID=your_google_sheet_id
# TENANT_CODE=the-org-code-to-import-into
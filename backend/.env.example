# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# Email (Resend)
RESEND_API_KEY=re_your_key
EMAIL_FROM=Attendance <noreply@attendance.app>

# Multi-tenancy
# Default tenant code applied when the client does not send one (dev convenience).
DEFAULT_TENANT=
# Secret used by the POST /provision endpoint to create new organisations.
# Leave EMPTY to enable fully self-serve signup (recommended for scaling).
# When set, provisioning is rejected unless this key is supplied.
MASTER_PIN=
# Max organisations creatable per calendar day (anti-abuse for open signup).
PROVISION_DAILY_LIMIT=50

# Server
PORT=3000

# Optional: database connection used only by `npm run apply-schema` (DDL runner).
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Google Sheets migration (only used by `npm run migrate`)
# SPREADSHEET_ID=your_google_sheet_id
# TENANT_CODE=the-org-code-to-import-into